{
  "name": "@rlanz/socket",
  "version": "0.0.1-10",
  "description": "WebSocket integration for AdonisJS",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.18.0",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./provider": "./build/providers/socket_provider.js",
    "./assembler_hook": "./build/src/assembler_hook.js",
    "./services/main": "./build/services/socket.js",
    "./decorators": "./build/src/decorators.js",
    "./health_check": "./build/src/health_check.js",
    "./otel": "./build/src/otel.js",
    "./testing": "./build/src/testing.js",
    "./types": "./build/src/types.js",
    "./types/tracing_channels": "./build/src/types/tracing_channels.js",
    "./client": "./build/src/client/index.js",
    "./client/types": "./build/src/client/types.js",
    "./client/react": "./build/src/client/react.js",
    "./client/vue": "./build/src/client/vue.js"
  },
  "scripts": {
    "build": "npm run compile",
    "clean": "del-cli build",
    "compile": "npm run clean && tsup-node",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "typecheck": "tsc --noEmit",
    "version": "npm run build"
  },
  "dependencies": {
    "@boringnode/bus": "^0.9.1",
    "@lukeed/ms": "^2.0.2",
    "emittery": "^1.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.9",
    "@types/react-test-renderer": "^19.1.0",
    "@types/scheduler": "^0",
    "@types/ws": "^8.18.1",
    "del-cli": "^7.0.0",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0",
    "react": "^19.1.1",
    "react-test-renderer": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "release-it": "^19.2.4",
    "scheduler": "^0.27.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.18"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.200.0",
    "react": "^18.0.0 || ^19.0.0",
    "typescript": "^5.9.0 || ^6.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/instrumentation": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "websocket",
    "realtime"
  ],
  "homepage": "https://github.com/rlanz/socket#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RomainLanz/socket"
  },
  "bugs": {
    "url": "https://github.com/rlanz/socket/issues"
  },
  "author": "Romain Lanz <romain.lanz@pm.me>",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  }
}
